# Values with EXPO_PUBLIC_ are bundled into the mobile app. Do not put secrets here.
EXPO_PUBLIC_APP_ENV=development

# Supabase project settings. The anon/publishable key is public by design; RLS protects data.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Use a public Mapbox token restricted by application, URL/bundle ID, and allowed APIs.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your-public-mapbox-token

# Optional: client error reporting DSN. This value is public.
EXPO_PUBLIC_SENTRY_DSN=
